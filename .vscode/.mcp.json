    {
      "id": "arg20",
      "type": "promptString",
      "description": "Logging level (e.g. debug, info, warning, error)",
      "default": ""
    },
    {
      "id": "arg21",
      "type": "promptString",
      "description": "Disable telemetry",
      "default": ""
    }
  ],
  "servers": {
    "microsoft/devbox-mcp-server": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@microsoft/devbox-mcp@latest"
      ],
      "internalMetadata": {
        "description": "This server enables natural language interactions for developer-focused operations like managing Dev Boxes, configurations, and pools.",
