        "@dynatrace-oss/dynatrace-managed-mcp-server@1.0.1"
      ],
      "env": {
        "DT_MCP_RATE_LIMIT_MAX_CALLS": "${input:arg17}",
        "DT_MCP_RATE_LIMIT_WINDOW_MS": "${input:arg18}",
        "DT_ENVIRONMENT_CONFIGS": "${input:arg19}",
