Screens:
  srcMatchDashboard:
    Properties:
      Fill: =ColorValue("#F5F7FA")
      LoadingSpinnerColor: =RGBA(0, 51, 102, 1)
    Children:
      - shpDashboardHeader:
          Control: Rectangle@2.3.0
          Properties:
            BorderColor: =RGBA(0, 89, 178, 1)
            Fill: =ColorValue("#03173E")
            Height: =88
            Width: =Parent.Width
      - lblDashboardTitle:
          Control: ModernText@1.0.0
          Properties:
            Color: =Color.White
            FontWeight: =FontWeight.Bold
            Height: =50
            Size: =25
            Text: ="Expanse Cutover Configuration & Suite"
            Width: =800
            X: =28
      - lblDashboardSubtitle:
          Control: ModernText@1.0.0
          Properties:
            Color: =ColorValue("#E05929")
            Font: =Font.'Open Sans'
            FontWeight: =FontWeight.Semibold
            Height: =38
            Size: =18
            Text: ="Registration | Target Match Dashboard"
            Width: =700
            X: =28
            Y: =38
      - galMatchDashboard:
          Control: Gallery@2.15.0
          Variant: BrowseLayout_Vertical_OneTextVariant_ver5.0
          Properties:
            BorderColor: =RGBA(0, 89, 178, 1)
            Fill: =RGBA(255, 255, 255, 1)
            Height: =301
            Items: |-
              =Table(
                  {
                      MatchCategory: "NO MATCH",
                      DisplayLabel: "No Match"
                  },
                  {
                      MatchCategory: "TEST",
                      DisplayLabel: "TEST"
                  },
                  {
                      MatchCategory: "ZCON",
                      DisplayLabel: "ZCON"
                  },
                  {
                      MatchCategory: "LIVE",
                      DisplayLabel: "LIVE"
                  }
              )
            OnSelect: |-
              =Set(
                  gblSelectedMatchCategory,
                  ThisItem.MatchCategory
              );
              Set(
                  gblDashboardExpanded,
                  true
              )
            ShowNavigation: =true
            TemplateSize: =75
            Width: =369
            X: =288
            Y: =137
          Children:
            - lblMatchCount:
                Control: ModernText@1.0.0
                Properties:
                  Align: =Align.Right
                  Font: =Font.'Open Sans'
                  Height: =53
                  Text: |-
                    =CountRows(
                        galExpandedMatchResults.AllItems
                    ) & " records"
                  Width: =107
                  X: =199
                  Y: =5
            - NextArrow9:
                Control: Classic/Icon@2.5.0
                Properties:
                  AccessibleLabel: =Self.Tooltip
                  BorderColor: =RGBA(0, 89, 178, 1)
                  Color: =RGBA(166, 166, 166, 1)
                  Height: =50
                  Icon: =Icon.ChevronRight
                  OnSelect: =Select(Parent)
                  PaddingBottom: =12
                  PaddingLeft: =12
                  PaddingRight: =12
                  PaddingTop: =12
                  Tooltip: ="View item details"
                  Width: =50
                  X: =321
                  Y: =7
            - Separator9:
                Control: Rectangle@2.3.0
                Properties:
                  BorderColor: =RGBA(0, 89, 178, 1)
                  Fill: =RGBA(255, 255, 255, 1)
                  Height: =8
                  OnSelect: =Select(Parent)
                  Width: =Parent.TemplateWidth
                  Y: =Parent.TemplateHeight - Self.Height
            - Rectangle9:
                Control: Rectangle@2.3.0
                Properties:
                  BorderColor: =RGBA(0, 89, 178, 1)
                  Fill: =RGBA(0, 89, 178, 1)
                  Height: =Parent.TemplateHeight - Separator9.Height
                  OnSelect: =Select(Parent)
                  Visible: =ThisItem.IsSelected
                  Width: =4
            - Title9:
                Control: Label@2.5.1
                Properties:
                  BorderColor: =RGBA(0, 0, 0, 1)
                  Color: =RGBA(50, 49, 48, 1)
                  Font: =Font.'Open Sans'
                  FontWeight: =FontWeight.Bold
                  Height: =27
                  OnSelect: =Select(Parent)
                  PaddingBottom: =0
                  PaddingLeft: =0
                  PaddingRight: =0
                  PaddingTop: =0
                  Size: =16
                  Text: =ThisItem.DisplayLabel
                  VerticalAlign: =VerticalAlign.Top
                  Width: =134
                  X: =25
                  Y: =18
      - shpExpandedHeaderAccent:
          Control: Rectangle@2.3.0
          Properties:
            BorderColor: =RGBA(0, 89, 178, 1)
            Fill: =ColorValue("#E05929")
            Height: =8
            Visible: =gblDashboardExpanded
            Width: =186
            X: =673
            Y: =125
      - lblModifyTargetEntry:
          Control: ModernText@1.0.0
          Properties:
            Align: =Align.Center
            Font: =Font.'Open Sans'
            FontWeight: =FontWeight.Lighter
            Height: =37
            Size: =14
            Text: ="Click > Arrow to Modify Record"
            Width: =250
            X: =1116
            Y: =92
      - lblExpandedResultsHeader:
          Control: ModernText@1.0.0
          Properties:
            Color: =ColorValue("#03173E")
            Fill: =RGBA(255, 255, 255, 0.02)
            Font: =Font.'Open Sans'
            FontWeight: =FontWeight.Bold
            Height: =49
            OnSelect: =true
            Size: =19
            Text: =gblSelectedMatchCategory & " Match Results"
            Visible: =gblDashboardExpanded
            Width: =280
            X: =673
            Y: =79
      - galExpandedMatchResults:
          Control: Gallery@2.15.0
          Variant: BrowseLayout_Vertical_TwoTextOneImageVariant_ver5.0
          Properties:
            BorderColor: =ColorValue("#D9E1EA")
            BorderThickness: =1
            FocusedBorderColor: =ColorValue("#E5E7EB")
            FocusedBorderThickness: '=1   '
            Height: =593
            Items: |-
              =AddColumns(
                  Filter(
                      'Facility Location',
                      FacilityMnem_Source = gblSelectedFacility
                  ),
                  SourceFacility,
                  FacilityMnem_Source,
                  SourceMnemonic,
                  LocationMnem,
                  SourceName,
                  LocationName,
                  SourceActive,
                  LocationActive,
                  TargetFacility,
                  "",
                  TargetMnemonic,
                  "",
                  TargetName,
                  "",
                  TargetActive,
                  "",
                  TargetMatchMtx,
                  "",
                  DBRecordCount,
                  Blank()
              )
            OnSelect: |-
              =Set(
                  gblSelectedAccommodation,
                  ThisItem
              );
              Navigate(
                  scrAccommodations,
                  ScreenTransition.Cover
              )
            TemplateFill: =Color.White
            TemplateSize: =150
            Width: =658
            X: =680
            Y: =137
          Children:
            - Title10:
                Control: Label@2.5.1
                Properties:
                  BorderColor: =RGBA(0, 0, 0, 1)
                  Color: =ColorValue("#03173E")
                  Font: =Font.'Open Sans'
                  FontWeight: =FontWeight.Bold
                  Height: =32
                  OnSelect: =Select(Parent)
                  PaddingBottom: =0
                  PaddingLeft: =0
                  PaddingRight: =0
                  PaddingTop: =0
                  Size: =14
                  Text: |-
                    =Coalesce(
                        ThisItem.SourceFacility,
                        ""
                    )
                  Width: =114
                  X: =4
            - Subtitle9:
                Control: Label@2.5.1
                Properties:
                  AutoHeight: =true
                  BorderColor: =RGBA(0, 0, 0, 1)
                  Color: =ColorValue("#54585A")
                  Font: =Font.'Open Sans'
                  Height: =35
                  LineHeight: =1.5
                  OnSelect: =Select(Parent)
                  PaddingBottom: =0
                  PaddingLeft: =0
                  PaddingRight: =0
                  PaddingTop: =0
                  Size: =11
                  Text: |-
                    =Coalesce(
                        ThisItem.SourceMnemonic,
                        ""
                    )
                  VerticalAlign: =VerticalAlign.Top
                  Width: =613
                  X: =10
                  Y: =95
            - NextArrow8:
                Control: Classic/Icon@2.5.0
                Properties:
                  AccessibleLabel: =Self.Tooltip
                  BorderColor: =RGBA(0, 0, 0, 1)
                  Color: =RGBA(166, 166, 166, 1)
                  DisabledBorderColor: =RGBA(56, 56, 56, 1)
                  DisabledColor: =RGBA(119, 119, 119, 1)
                  Height: =93
                  Icon: =Icon.ChevronRight
                  OnSelect: |-
                    =Set(
                        gblSelectedAccommodation,
                        ThisItem
                    );
                    Navigate(
                        scrAccommodations,
                        ScreenTransition.Cover
                    )
                  PaddingBottom: =16
                  PaddingLeft: =16
                  PaddingRight: =16
                  PaddingTop: =16
                  Tooltip: ="View item details"
                  Width: =75
                  X: =581
                  Y: =22
            - Separator8:
                Control: Rectangle@2.3.0
                Properties:
                  BorderColor: =RGBA(255, 255, 255, 1)
                  BorderThickness: =1
                  Fill: =RGBA(255, 255, 255, 1)
                  Height: =8
                  OnSelect: =Select(Parent)
                  Width: =Parent.TemplateWidth
                  Y: =142
            - Rectangle8:
                Control: Rectangle@2.3.0
                Properties:
                  BorderColor: =RGBA(0, 89, 178, 1)
                  Fill: =RGBA(0, 89, 178, 1)
                  Height: =Parent.TemplateHeight - Separator8.Height
                  OnSelect: =Select(Parent)
                  Visible: =ThisItem.IsSelected
                  Width: =4
            - lblExpandedTargetValue:
                Control: ModernText@1.0.0
                Properties:
                  Font: =Font.'Open Sans'
                  Height: =37
                  OnSelect: =Select(Parent)
                  Size: =14
                  Text: |-
                    =Coalesce(
                        ThisItem.TargetName,
                        ""
                    )
                  Width: =252
                  X: =10
                  Y: =62
            - lblExpandedSourceActive:
                Control: ModernText@1.0.0
                Properties:
                  Color: =ColorValue("#54585A")
                  OnSelect: =Select(Parent)
                  Text: |-
                    =Coalesce(
                        ThisItem.SourceActive
                    )
                  X: =289
                  Y: =38
            - lblExpandedSource:
                Control: ModernText@1.0.0
                Properties:
                  AutoHeight: =true
                  BorderColor: =Color.Black
                  Color: =ColorValue("#03173E")
                  Font: =Font.'Open Sans'
                  Height: =33
                  OnSelect: =Select(Parent)
                  Size: =14
                  Text: |-
                    =Coalesce(
                        ThisItem.SourceName,
                        ""
                    )
                  VerticalAlign: =VerticalAlign.Top
                  Width: =648
                  X: =4
                  Y: =40
            - lblExpandedWorksheet:
                Control: ModernText@1.0.0
                Properties:
                  Align: =Align.Center
                  Color: =ColorValue("#54585A")
                  Font: =Font.'Open Sans'
                  FontWeight: =FontWeight.Bold
                  Height: =43
                  OnSelect: =Select(Parent)
                  Size: =18
                  Text: |-
                    =Coalesce(
                        ThisItem.DBRecordCount)
                  VerticalAlign: =VerticalAlign.Top
                  Width: =65
                  X: =332
                  Y: =94
            - lblDBRecordCount:
                Control: ModernText@1.0.0
                Properties:
                  Height: =35
                  OnSelect: =Select(Parent)
                  Text: |-
                    =If(
                        IsBlank(ThisItem.DBRecordCount),
                        Text(ThisItem.DBRecordCount)
                    )
                  Width: =234
                  X: =269
                  Y: =62
            - lblExpandedMappingStatus:
                Control: ModernText@1.0.0
                Properties:
                  Color: |-
                    =If(
                        ThisItem.TargetMatchMtx = "NO MATCH",
                        Color.Red,
                        ColorValue("#54585A")
                    )
                  FontWeight: =FontWeight.Bold
                  Height: =57
                  OnSelect: =Select(Parent)
                  Text: |-
                    =If(
                        IsBlank(ThisItem.TargetMatchMtx),
                        "Mapping pending",
                        ThisItem.TargetMatchMtx
                    )
                  VerticalAlign: =VerticalAlign.Top
                  Width: =100
                  X: =763
                  Y: =51
            - lblExpandedTargetMatch:
                Control: ModernText@1.0.0
                Properties:
                  Color: |-
                    =If(
                        IsBlank(ThisItem.TargetMatchMtx) ||
                        ThisItem.TargetMatchMtx = "NO MATCH",
                        Color.Red,
                        ColorValue("#54585A")
                    )
                  Font: =Font.'Open Sans'
                  FontWeight: |-
                    =If(
                        IsBlank(ThisItem.TargetMatchMtx) ||
                        ThisItem.TargetMatchMtx = "NO MATCH",
                        FontWeight.Bold,
                        FontWeight.Normal
                    )
                  Height: =36
                  OnSelect: =Select(Parent)
                  Size: =14
                  Text: |-
                    =Coalesce(
                        ThisItem.TargetMatchMtx,
                        ""
                    )
                  VerticalAlign: =VerticalAlign.Top
                  Width: =372
                  X: =269
                  Y: =4
      - btnBack:
          Control: ModernButton@1.0.0
          Properties:
            Font: =Font.'Open Sans'
            FontWeight: =FontWeight.Normal
            Icon: ="ArrowLeft"
            OnSelect: |-
              =Set(
                  gblDashboardExpanded,
                  false
              );
              Back()
            Size: =16
            Text: ="BACK"
            X: =801
            Y: =28
      - btnNext:
          Control: ModernButton@1.0.0
          Properties:
            Font: =Font.'Open Sans'
            FontWeight: =FontWeight.Normal
            Icon: ="ArrowRight"
            Layout: =ButtonLayout.IconAfter
            OnSelect: |-
              =Set(
                  gblSelectedWorksheet,
                  With(
                      {
                          _rows: Sort(
                              'Reg Config Categories',
                              'Reg Worksheet Name',
                              SortOrder.Ascending
                          ),
                          _current: drpWorksheetName.Selected.'Reg Worksheet Name'
                      },
                      If(
                          IsBlank(_current),
                          First(_rows).'Reg Worksheet Name',
                          If(
                              _current =
                                  Last(_rows).'Reg Worksheet Name',
                              First(_rows).'Reg Worksheet Name',
                              Index(
                                  _rows,
                                  LookUp(
                                      Sequence(CountRows(_rows)),
                                      Index(
                                          _rows,
                                          Value
                                      ).'Reg Worksheet Name' = _current
                                  ).Value + 1
                              ).'Reg Worksheet Name'
                          )
                      )
                  )
              );
              Reset(drpWorksheetName);
              Set(
                  gblDashboardExpanded,
                  false
              )
            Size: =16
            Text: ="NEXT"
            X: =1133
            Y: =28
      - btnRefreshResults:
          Control: ModernButton@1.0.0
          Properties:
            Align: =Align.Center
            BasePaletteColor: =RGBA(5, 102, 178, 1)
            Color: =RGBA(255, 255, 255, 1)
            Font: =Font.'Open Sans'
            FontWeight: =FontWeight.Normal
            Height: =42
            Icon: ="ArrowClockwise"
            OnSelect: |-
              =Refresh('Accommodation Data Clone');
              Refresh('Reg Config Categories');
              Set(
                  gblDashboardRefreshTime,
                  Now()
              )
            Size: =16
            Text: ="Refresh Results"
            Width: =175
            X: =216
            Y: =460
      - drpWorksheetName:
          Control: ModernDropdown@1.0.3
          Properties:
            Font: =Font.'Open Sans'
            Height: =36
            ItemDisplayText: =ThisItem.'Reg Worksheet Name'
            Items: |-
              =Sort(
                  Filter(
                      'Reg Config Categories',
                      'Reg Worksheet Name' <> "REG ALL" &&
                      'Reg Worksheet Name' <> "REG [INSERT-UPLOAD]" &&
                      'Reg Worksheet Name' <> "Reg Worksheet Name" &&
                      !IsBlank('Reg Worksheet Name')
                  ),
                  'Reg Worksheet Name',
                  SortOrder.Ascending
              )
            OnChange: |-
              =Set(
                  gblSelectedWorksheet,
                  drpWorksheetName.Selected.'Reg Worksheet Name'
              );

              Set(
                  gblSelectedAccommodation,
                  Blank()
              );

              Set(
                  gblEditMode,
                  false
              );

              Set(
                  gblSyncConfirmed,
                  false
              )
            Size: =18
            Width: =264
            X: =13
            Y: =337
      - lblWorksheetName:
          Control: ModernText@1.0.0
          Properties:
            Color: =RGBA(13, 50, 61, 1)
            Fill: =RGBA(13, 50, 61, 0.01)
            Font: =Font.'Open Sans'
            FontWeight: =FontWeight.Semibold
            Height: =41
            OnSelect: |-
              =Set(
                  gblSelectedWorksheet,
                  drpWorksheetName.Selected.'Reg Worksheet Name'
              );
              Set(
                  gblDashboardExpanded,
                  false
              )
            Text: ="Worksheet Name (REG)"
            Width: =252
            X: =13
            Y: =287
      - cmbFacilities:
          Control: ModernDropdown@1.0.3
          Properties:
            Height: =36
            ItemDisplayText: =ThisItem.Value
            Items: |-
              =Sort(
                  Distinct(
                      Filter(
                          'dim.Ref.Organizations',
                          'Wave Number' = gblSelectedWaveNumber &&
                          'SubWave Code' = gblSelectedSubWaveCode &&
                          !IsBlank('Facility Mnemonic') &&
                          'Facility Mnemonic' <> "Facility Mnemonic" &&
                          'Facility Mnemonic' <> "NULL"
                      ),
                      'Facility Mnemonic'
                  ),
                  Value,
                  SortOrder.Ascending
              )
            OnChange: |-
              =Set(
                  gblSelectedFacility,
                  cmbFacilities.Selected.Value
              );

              Set(
                  gblSelectedNetworkMnemonic,
                  LookUp(
                      'dim.Ref.Organizations',
                      'Wave Number' = gblSelectedWaveNumber &&
                      'SubWave Code' = gblSelectedSubWaveCode &&
                      'Facility Mnemonic' = cmbFacilities.Selected.Value,
                      'Network Mnemonic'
                  )
              );

              Set(
                  gblSelectedAccommodation,
                  Blank()
              );

              Set(
                  gblEditMode,
                  false
              );

              Set(
                  gblSyncConfirmed,
                  false
              )
            PaddingBottom: =10
            PaddingLeft: =10
            PaddingRight: =10
            PaddingTop: =10
            Width: =264
            X: =13
            Y: =237
      - lblFilterbyFaciltyDshboard:
          Control: ModernText@1.0.0
          Properties:
            AutoHeight: =true
            Color: =ColorValue("#03173E")
            Font: =Font.'Open Sans'
            FontWeight: =FontWeight.Semibold
            Text: ="Filter by Facility"
            X: =13
            Y: =204
      - drpWaveSubwave:
          Control: Classic/DropDown@2.3.1
          Properties:
            BorderColor: =RGBA(0, 89, 178, 1)
            ChevronBackground: =RGBA(0, 51, 102, 1)
            ChevronFill: =RGBA(255, 255, 255, 1)
            ChevronHoverBackground: =ColorFade(RGBA(0, 51, 102, 1), -20%)
            ChevronHoverFill: =RGBA(255, 255, 255, 1)
            Default: =
            Font: =Font.'Open Sans'
            Height: =36
            HoverFill: =RGBA(153, 205, 255, 1)
            Items: |-
              =Sort(
                  Distinct(
                      Filter(
                          'dim.Ref.Organizations',
                          !IsBlank('Wave Number') &&
                          !IsBlank('SubWave Code') &&
                          'Wave Number' <> "Wave" &&
                          'SubWave Code' <> "SubWave" &&
                          'Wave Number' <> "NULL" &&
                          'SubWave Code' <> "NULL"
                      ),
                      'Wave Number' & " - " & 'SubWave Code'
                  ),
                  Value,
                  SortOrder.Ascending
              )
            Items.Value: =Value
            OnChange: |-
              =Set(
                  gblSelectedWaveSubwave,
                  drpWaveSubwave.Selected.Value
              );

              Set(
                  gblSelectedWaveNumber,
                  Left(
                      drpWaveSubwave.Selected.Value,
                      Find(
                          " - ",
                          drpWaveSubwave.Selected.Value
                      ) - 1
                  )
              );

              Set(
                  gblSelectedSubWaveCode,
                  Mid(
                      drpWaveSubwave.Selected.Value,
                      Find(
                          " - ",
                          drpWaveSubwave.Selected.Value
                      ) + 3,
                      Len(
                          drpWaveSubwave.Selected.Value
                      )
                  )
              );

              Reset(cmbFacilities);

              Set(
                  gblSelectedFacility,
                  Blank()
              );

              Set(
                  gblSelectedNetworkMnemonic,
                  Blank()
              );

              Set(
                  gblSelectedAccommodation,
                  Blank()
              );

              Set(
                  gblEditMode,
                  false
              );

              Set(
                  gblSyncConfirmed,
                  false
              )
            OnSelect: |-
              =Set(
                  gblSelectedWaveSubwave,
                  drpWaveSubwave.Selected.Value
              );

              Set(
                  gblSelectedWaveNumber,
                  Left(
                      drpWaveSubwave.Selected.Value,
                      Find(
                          " - ",
                          drpWaveSubwave.Selected.Value
                      ) - 1
                  )
              );

              Set(
                  gblSelectedSubWaveCode,
                  Mid(
                      drpWaveSubwave.Selected.Value,
                      Find(
                          " - ",
                          drpWaveSubwave.Selected.Value
                      ) + 3,
                      Len(
                          drpWaveSubwave.Selected.Value
                      )
                  )
              );

              Reset(cmbFacilities);

              Set(
                  gblSelectedFacility,
                  Blank()
              );

              Set(
                  gblSelectedNetworkMnemonic,
                  Blank()
              );

              Set(
                  gblSelectedAccommodation,
                  Blank()
              );

              Set(
                  gblEditMode,
                  false
              );

              Set(
                  gblSyncConfirmed,
                  false
              )
            PressedColor: =RGBA(255, 255, 255, 1)
            PressedFill: =RGBA(0, 89, 178, 1)
            SelectionColor: =RGBA(255, 255, 255, 1)
            SelectionFill: =RGBA(0, 51, 102, 1)
            Width: =264
            X: =13
            Y: =137
      - lblFilterbyWave:
          Control: ModernText@1.0.0
          Properties:
            AutoHeight: =true
            Color: =ColorValue("#03173E")
            Font: =Font.'Open Sans'
            FontWeight: =FontWeight.Semibold
            Text: ="Filter by Wave/Subwave"
            Width: =203
            X: =13
            Y: =105
      - btnReset:
          Control: ModernButton@1.0.0
          Properties:
            Font: =Font.'Open Sans'
            FontWeight: =FontWeight.Normal
            Icon: ="ArrowSync"
            Size: =16
            Text: ="RESET"
            Width: =99
            X: =970
            Y: =28
      - lblExpandSelect:
          Control: ModernText@1.0.0
          Properties:
            Align: =Align.Center
            Font: =Font.'Open Sans'
            FontWeight: =FontWeight.Lighter
            Height: =41
            Size: =14
            Text: ="Click > Arrow to Expand Results"
            Width: =265
            X: =407
            Y: =92
      - btnHome:
          Control: ModernButton@1.0.0
          Properties:
            Font: =Font.'Open Sans'
            FontWeight: =FontWeight.Normal
            Icon: ="Home"
            OnSelect: |-
              =Navigate(
                  scrRegistrationLaunchpad,
                  ScreenTransition.Fade
              )
            Size: =14
            Text: ="HOME"
            X: =591
            Y: =28
