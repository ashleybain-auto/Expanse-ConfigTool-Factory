// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/java
{
	"name": "Java",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/java:3-25-trixie",

	"features": {
		"ghcr.io/devcontainers/features/java:1": {
			"version": "none",
			"installMaven": "true",
			"installGradle": "true"
		},
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/natescherer/devcontainers-custom-features/powershell-resources:1": {},
		"ghcr.io/christophermacgown/devcontainer-features/easy-container-hooks:1": {},
		"ghcr.io/devcontainers-extra/features/corepack:1": {},
		"ghcr.io/devcontainers-extra/features/devcontainers-cli:1": {},
		"ghcr.io/devcontainers-extra/features/vscode-cli:1": {},
		"ghcr.io/devcontainer-community/devcontainer-features/add-script:1": {},
		"ghcr.io/devcontainer-community/devcontainer-features/run-script:1": {},
		"ghcr.io/helpers4/devcontainer/copilot-dev:1": {},
		"ghcr.io/helpers4/devcontainer/essential-dev:1": {},
		"ghcr.io/helpers4/devcontainer/github-dev:1": {},
		"ghcr.io/devcontainer-config/features/dot-config:4": {},
		"ghcr.io/devcontainer-config/features/unset-git-credential-helper:0": {},
		"ghcr.io/sliekens/devcontainer-features/opencode:1": {}
	}

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "java -version",

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
